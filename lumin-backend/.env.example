# Lumin backend settings. On Railway set these as service Variables (never commit a real .env).
# REQUIRED = the app will not start without it.

# --- Core (REQUIRED) -------------------------------------------------------------------------------------------
# Railway Postgres plugin: use its DATABASE_URL (reference variable ${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgresql://user:password@host:5432/lumin
# Long random secret that signs logins: `openssl rand -hex 32`. Also encrypts admin authenticator secrets, so
# changing it later signs everyone out AND forces admins to set up their authenticator again.
JWT_SECRET_KEY=
# Public address of the website (password-reset and email links point here; also allowed by CORS).
FRONTEND_URL=https://your-site.example.com
# Extra allowed websites, comma separated - add the admin console's address here.
CORS_ORIGINS=https://your-admin.example.com
# Set to "production" on the live service: hides /docs, labels errors in Sentry, makes email confirmation strict.
ENVIRONMENT=production

# Platform name used in emails, push titles and messages the API returns. Empty = "Lumin". (Website: NEXT_PUBLIC_APP_NAME.)
APP_NAME=

# --- Sign-in with Google (REQUIRED) ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=

# --- Sign in with Apple (needed for the iPhone app; optional for the website) ---------------------------------------
# Comma-separated: the iPhone app's bundle id, and the website's "Services ID" from developer.apple.com.
# Empty = Sign in with Apple is off. See NATIVE.md section 5.
APPLE_CLIENT_IDS=

# --- Content moderation (optional but needed for App Store / Play approval) ---------------------------------------
# Picture checks for nudity and violence. Empty = off (the word filter and reports still work).
# Free key: platform.openai.com (the moderation endpoint costs nothing).
MODERATION_PROVIDER=
OPENAI_API_KEY=
# A score at or above HOLD hides a video until an admin decides; REVIEW only queues it. 0 to 1.
MODERATION_HOLD_SCORE=0.8
MODERATION_REVIEW_SCORE=0.5
# This many DIFFERENT people reporting a video hides it for review (0 = never auto-hide).
MODERATION_REPORT_HOLD=3

# --- Payments: one provider per country (app/countries.py) ---------------------------------------------------------
# Nigeria is paid through Paystack, the US and UK through Stripe. Every provider a switched-on country uses must have its keys
# set or the server refuses to start. Stripe: buyers pay the platform; each order's money is held, then transferred to the seller's
# Stripe Express account when the order is released (see app/stripe_gateway.py). Use TEST keys until you have run the checks in
# PRODUCTION.md.
# PAYMENT_PROVIDER / PAYMENT_CURRENCY below are only the fallback for payments and sellers from before countries decided this.
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=
# Dashboard > Developers > Webhooks > add endpoint  https://<backend-address>/payments/stripe-webhook  with the events
#   payment_intent.succeeded, payment_intent.payment_failed, account.updated   then paste its signing secret (whsec_...) here.
STRIPE_WEBHOOK_SECRET=
# Currency charged. Defaults to USD with Stripe and NGN with Paystack. With Paystack it MUST be NGN: Paystack pays sellers in
# naira only, and the server refuses to start with Paystack in any other currency. Set the SAME code in the websites as NEXT_PUBLIC_CURRENCY.
PAYMENT_CURRENCY=USD
# Paystack (Nigeria). Webhook URL: https://<backend-address>/payments/webhook
# with the events charge.success, transfer.failed and transfer.reversed.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Where Lumin is open: two-letter country codes, comma-separated, each needing a payment route in app/countries.py. Sellers must
# collect from, and buyers be delivered to, one of them, and an order must be domestic. Empty = NG,US,GB. Ghana, Kenya, South
# Africa and the Stripe EEA/Canada/Switzerland routes are listed but unverified: ALLOW_UNVERIFIED_ROUTES=true to switch them on.
# Set the same list in the website as NEXT_PUBLIC_LAUNCH_COUNTRIES. Per-country delivery price: SHIPPING_FLAT_FEE_NG, _US ...
LAUNCH_COUNTRIES=NG,US,GB
# Delivery price when no live courier rate is used, in the charged currency. These win over the seeded delivery company, whose
# numbers are dollar-sized (4.99, free over 50). FREE_SHIPPING_THRESHOLD=0 turns free delivery off.
# SHIPPING_FLAT_FEE=2500
# FREE_SHIPPING_THRESHOLD=0

# --- File storage: Cloudflare R2 (REQUIRED) --------------------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public address the bucket is served from (custom domain or r2.dev address), no trailing slash.
R2_PUBLIC_BASE_URL=https://cdn.your-site.example.com
# The bucket's CORS rule must allow PUT from your website's address (uploads go straight from the browser).
# Upload size limits in MB, and whether the signed upload URL also enforces the size (set false if R2 rejects uploads).
MAX_IMAGE_MB=10
MAX_VIDEO_MB=200
SIGN_UPLOAD_SIZE=true

# Seller verification: a SECOND bucket with NO public access and no public domain (ID photos go here; the same API
# token must be able to read/write it). Leave empty and seller verification stays switched off.
R2_PRIVATE_BUCKET_NAME=
# true = sellers' payouts wait until an admin has verified them.
REQUIRE_VERIFIED_SELLERS_FOR_PAYOUT=false

# --- Email: Resend ------------------------------------------------------------------------------------------------------
# Needed for signup confirmation codes and password resets. Verify your own domain in Resend first; the default
# sender only delivers to your own address.
RESEND_API_KEY=
EMAIL_FROM=Lumin <no-reply@your-site.example.com>
# Signup needs the emailed code. Only set to false while Resend is not set up yet.
REQUIRE_EMAIL_VERIFICATION=true

# --- Admin protection ------------------------------------------------------------------------------------------------------
# Admins must use an authenticator-app code. Emergency escape hatch only (see README): false = admins who have not
# enrolled yet can use the console with just a password.
REQUIRE_ADMIN_MFA=true

# --- Push notifications (optional; off until both keys are set) --------------------------------------------------------
# Generate once: npx web-push generate-vapid-keys   - keep the pair forever.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@your-site.example.com

# --- Native app push (Android/iPhone) -------------------------------------------------------------------------------------
# Firebase service-account key: paste the WHOLE .json file contents as this one variable. See ../NATIVE.md. Off when empty.
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- Background work ---------------------------------------------------------------------------------------------------------
# Video re-encoding and scan fingerprinting run as queued jobs. true = inside the web server (works out of the box);
# set false on the WEB service once a separate worker service (DEPLOY.md section 6) is running.
RUN_JOBS_IN_WEB=true

# --- Monitoring (optional) ------------------------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=INFO

# --- Features and tuning (optional) -----------------------------------------------------------------------------------------
# Twin discovery layer. Turn on together with NEXT_PUBLIC_TWIN_ENABLED=true on the website.
TWIN_ENABLED=
# Scan ("find the video from a recording") limits.
SCAN_MAX_CLIP_MB=30
SCAN_MAX_CLIP_SECONDS=20
SCAN_MIN_CLIP_SECONDS=2
SCAN_MAX_LINK_MB=60
SCAN_LINK_TIMEOUT_S=25
SCAN_ORB_FULL_SEARCH_MAX=20000
# Only if ffmpeg is not on PATH (the Docker image has it).
FFMPEG_DIR=
# Addresses allowed to set X-Forwarded-For (default * suits Railway's proxy).
FORWARDED_ALLOW_IPS=*

# --- Orders: delivery, collect in person, auto-cancel (all optional; the value shown is the default) --------------------------
# manual = an admin / the courier's own key marks pickups and deliveries; terminal = Terminal Africa books and tracks them.
COURIER=manual
COURIER_API_KEY=
# A seller must tap "Ready for pickup" within this many hours, is reminded at the second number, and the order is
# cancelled and refunded if it is still not done.
AUTO_CANCEL_UNPACKED_HOURS=72
AUTO_REMIND_UNPACKED_HOURS=48
# After "Ready for pickup", the courier must collect within this many hours or the order is cancelled and refunded.
AUTO_CANCEL_UNCOLLECTED_HOURS=72
# Days a buyer has to visit and decide on a collect-in-person order (shown to buyers and sellers from this value).
COLLECT_WINDOW_DAYS=7
# Heaviest single item sent by courier (grams); heavier or bigger becomes collect in person. Above the second number
# a posted product must give its length, width and height.
MAX_SHIPPABLE_GRAMS=30000
DIMENSIONS_REQUIRED_OVER_GRAMS=5000
# Most sponsored add-on products looked at for one "Buy this too" / cart / video request. Only matters with thousands of them.
SPONSORED_CANDIDATE_LIMIT=500
# Days a product stays in New Arrivals after it is listed (then it is no longer "new"). 0 = never expires.
NEW_ARRIVAL_DAYS=14
# Hours a buyer has to raise a problem after delivery.
CLAIM_WINDOW_HOURS=48

# --- NEVER on a real deployment ----------------------------------------------------------------------------------------------
# Loads demo people/videos with PUBLIC logins (incl. an admin with password "password123"). Local development only.
SEED_DEMO_DATA=false
