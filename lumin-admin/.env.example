# Lumin admin console. Read when the console is BUILT (set as Variables, then redeploy).
# Address of the backend (no trailing slash). The backend must list this console's own address in CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Platform name shown in the admin panel (same value as the website NEXT_PUBLIC_APP_NAME and the backend APP_NAME). Empty = "Lumin".
NEXT_PUBLIC_APP_NAME=
